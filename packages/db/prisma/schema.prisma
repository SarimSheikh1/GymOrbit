generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
 OWNER
 MANAGER
 FRONT_DESK
 TRAINER
 MEMBER
}
enum MemberStatus {
 ACTIVE
 EXPIRING
 EXPIRED
 FROZEN
 ARCHIVED
}
enum SubscriptionStatus {
 ACTIVE
 EXPIRING
 EXPIRED
 FROZEN
 CANCELLED
}
enum InvoiceStatus {
 DRAFT
 OPEN
 PARTIALLY_PAID
 PAID
 VOID
 REFUNDED
}
enum PaymentMethod {
 CASH
 CARD
 BANK_TRANSFER
 JAZZCASH
 EASYPAISA
 STRIPE
}

model User {
 id String @id @default(cuid())
 name String
 email String @unique
 phone String? @unique
 passwordHash String
 role Role @default(MEMBER)
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 member Member?
 auditLogs AuditLog[]
}
model Branch {
 id String @id @default(cuid())
 name String
 address String?
 phone String?
 timezone String @default("Asia/Karachi")
 createdAt DateTime @default(now())
 members Member[]
}
model Member {
 id String @id @default(cuid())
 memberCode String @unique
 branchId String
 userId String? @unique
 name String
 phone String @unique
 email String?
 dob DateTime?
 gender String?
 address String?
 emergencyName String?
 emergencyPhone String?
 photoUrl String?
 medicalNotes String?
 status MemberStatus @default(ACTIVE)
 joinedAt DateTime @default(now())
 archivedAt DateTime?
 branch Branch @relation(fields: [branchId], references: [id])
 user User? @relation(fields: [userId], references: [id])
 subscriptions Subscription[]
 invoices Invoice[]
 payments Payment[]
 attendance Attendance[]
 @@index([branchId, status])
 @@index([phone])
}
model Plan {
 id String @id @default(cuid())
 name String @unique
 durationDays Int
 price Int
 joiningFee Int @default(0)
 freezeDays Int @default(0)
 description String?
 isActive Boolean @default(true)
 subscriptions Subscription[]
}
model Subscription {
 id String @id @default(cuid())
 memberId String
 planId String
 startDate DateTime
 endDate DateTime
 status SubscriptionStatus @default(ACTIVE)
 freezeStart DateTime?
 freezeEnd DateTime?
 priceAtPurchase Int
 discount Int @default(0)
 member Member @relation(fields: [memberId], references: [id])
 plan Plan @relation(fields: [planId], references: [id])
 invoices Invoice[]
 @@index([memberId, endDate])
 @@index([endDate])
}
model Invoice {
 id String @id @default(cuid())
 number String @unique
 memberId String
 subscriptionId String?
 subtotal Int
 discount Int @default(0)
 tax Int @default(0)
 total Int
 paidAmount Int @default(0)
 status InvoiceStatus @default(OPEN)
 issuedAt DateTime @default(now())
 dueAt DateTime?
 member Member @relation(fields: [memberId], references: [id])
 subscription Subscription? @relation(fields: [subscriptionId], references: [id])
 items InvoiceItem[]
 payments Payment[]
}
model InvoiceItem {
 id String @id @default(cuid())
 invoiceId String
 description String
 qty Int @default(1)
 unitPrice Int
 total Int
 invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
model Payment {
 id String @id @default(cuid())
 invoiceId String
 memberId String
 amount Int
 method PaymentMethod
 reference String?
 receivedBy String?
 paidAt DateTime @default(now())
 invoice Invoice @relation(fields: [invoiceId], references: [id])
 member Member @relation(fields: [memberId], references: [id])
}
model Attendance {
 id String @id @default(cuid())
 memberId String
 branchId String
 checkInAt DateTime @default(now())
 checkOutAt DateTime?
 method String @default("SEARCH")
 member Member @relation(fields: [memberId], references: [id])
 @@index([memberId, checkInAt])
 @@index([branchId, checkInAt])
}
model AuditLog {
 id String @id @default(cuid())
 userId String?
 action String
 entity String
 entityId String?
 meta Json?
 createdAt DateTime @default(now())
 user User? @relation(fields: [userId], references: [id])
 @@index([entity, entityId])
}
